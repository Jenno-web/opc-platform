{
  "name": "opc-platform",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "apps/backend",
    "apps/frontend",
    "apps/frontend-desktop"
  ],
  "scripts": {
    "dev:backend": "npm run start:dev --workspace backend",
    "dev:frontend": "npm run dev:h5 --workspace frontend",
    "dev:desktop": "npm run dev --workspace frontend-desktop",
    "build:desktop": "npm run build --workspace frontend-desktop",
    "db:migrate": "npm run prisma:migrate --workspace backend",
    "db:seed": "npm run prisma:seed --workspace backend",
    "build": "npm run build --workspace backend",
    "start": "npm run deploy:start --workspace backend"
  }
}
